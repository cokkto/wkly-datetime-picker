{
  "name": "wkly-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node scripts/test.cjs",
    "showcase:start": "node scripts/serve.cjs",
    "showcase:build": "node scripts/showcase-build.cjs",
    "showcase:test:e2e": "node scripts/playwright.cjs test",
    "showcase:test:e2e:update": "node scripts/playwright.cjs test --update-snapshots",
    "showcase:browsers": "node scripts/playwright.cjs install chromium firefox webkit",
    "pack:check": "node scripts/pack.cjs",
    "format:ts": "prettier --write \"projects/**/src/**/*.ts\"",
    "format:html": "prettier --write \"projects/**/src/**/*.html\""
  },
  "devDependencies": {
    "@angular/animations": "11.2.14",
    "@angular/cdk": "11.2.13",
